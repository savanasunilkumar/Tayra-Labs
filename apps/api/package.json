{
  "name": "@inqox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply inqox-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply inqox-db --remote",
    "wrangler:login": "wrangler login",
    "wrangler:whoami": "wrangler whoami"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.135.0"
  }
}
