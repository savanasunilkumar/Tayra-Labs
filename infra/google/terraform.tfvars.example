project_id         = "replace-with-dedicated-project-id"
product_name       = "Video API"
resource_prefix    = "video-api"
region             = "us-central1"
allowed_origin     = "http://localhost:3000"
create_staging_job = false
deploy_services    = false
deploy_api_only    = false
gpu_paused         = false
enable_hf_auth     = false
public_api_enabled = false
